{
	"name": "flagly",
	"version": "2.0.0",
	"description": "Library for parsing and handling permission or feature flags.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/utily/flagly.git"
	},
	"bugs": {
		"url": "https://github.com/utily/flagly/issues"
	},
	"homepage": "https://github.com/utily/flagly",
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rimraf dist node_modules coverage",
		"format": "biome format --write .",
		"lint": "biome format .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"verify": "npm run build && npm run format && npm run test && npm audit --omit=dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@vitest/coverage-v8": "^5.1.2",
		"rimraf": "^6.1.4",
		"semantic-release": "^21.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	},
	"dependencies": {
		"isly": "^1.10.0"
	}
}
